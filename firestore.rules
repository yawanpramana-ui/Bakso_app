rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Party rooms & subcollections (e.g. messages)
    match /parties/{partyId} {
      allow read, create, update, write: if true;

      match /messages/{messageId} {
        allow read, create, update, write: if true;
      }
    }

    // Spots collection
    match /spots/{spotId} {
      allow read, write: if request.auth != null;
    }

    // Global Public Chat collection & room document
    match /global_messages/{messageId} {
      allow read, create, update, write: if true;
    }

    match /global_chat/{roomId} {
      allow read, create, update, write: if true;
    }
  }
}
